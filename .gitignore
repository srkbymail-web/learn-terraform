# Core Terraform directories
.terraform/

# Hide planning data / log files
crash.log
crash.*.log
*tfplan*

# Ignore all TF state files (Contains secrets, managed remotely instead)
*.tfstate
*.tfstate.*

# Exclude sensitive variable files
*.tfvars
*.tfvars.json

# Exclude local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
